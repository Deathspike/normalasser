{
  "main": "index.js",
  "name": "normalasser",
  "repository": "git://github.com/Deathspike/normalasser",
  "type": "module",
  "bin": {
    "normalasser": "./bin/cli.js"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-porcupine": "0.4.0",
    "prettier": "3.9.10",
    "prettier-plugin-jsdoc": "1.8.1",
    "typescript": "6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "onFail": "error",
      "version": ">= 10"
    },
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": ">= 24"
    }
  },
  "scripts": {
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint:check": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "prepack": "tsc index.js --allowJs --declaration --emitDeclarationOnly --removeComments --strict --skipLibCheck",
    "test": "npm run types:check && npm run lint:check && npm run format:check",
    "types:check": "tsc --project jsconfig.json",
    "types:watch": "tsc --project jsconfig.json --watch"
  }
}
