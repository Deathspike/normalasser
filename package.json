{
  "name": "normalasser",
  "author": "Deathspike",
  "description": "Extracts ASS subtitles from MKV video files and normalizes their appearance to enhance readability and ensure consistency.",
  "license": "MIT",
  "repository": "git://github.com/Deathspike/normalasser",
  "type": "module",
  "version": "3.0.2",
  "main": "./src/index.js",
  "bin": {
    "normalasser": "./bin/cli.js"
  },
  "engines": {
    "node": ">= 24.0.0",
    "npm": ">= 10.0.0"
  },
  "devDependencies": {
    "@types/node": "24.6.2",
    "pre-commit": "1.2.2",
    "prettier": "3.9.8",
    "prettier-plugin-jsdoc": "1.8.1",
    "typescript": "6.0.3"
  },
  "scripts": {
    "prepack": "npm run tsc:build",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test": "npm run prettier:check && npm run tsc:build",
    "tsc:build": "tsc --project jsconfig.json",
    "tsc:watch": "tsc --project jsconfig.json --watch"
  }
}
